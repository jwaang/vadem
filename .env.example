# Convex deployment URL — run `npx convex dev` to populate
NEXT_PUBLIC_CONVEX_URL=

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/auth/callback/google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In — configure at https://developer.apple.com/account/resources/identifiers/list/serviceId
# Authorized redirect URI: https://your-domain.com/auth/callback/apple
# APPLE_PRIVATE_KEY: PEM content of your .p8 key file (newlines as \n)
NEXT_PUBLIC_APPLE_CLIENT_ID=
# Override Apple redirect origin for dev (Apple blocks localhost) — set to your ngrok/tunnel URL
NEXT_PUBLIC_APPLE_REDIRECT_ORIGIN=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Twilio — SMS OTP for vault verification via Verify V2
# Set all three in Convex dashboard → Settings → Environment Variables (NOT .env.local)
# Create a Verify Service in Twilio console first: https://console.twilio.com/verify/services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Purchased Twilio phone number for outbound SMS reminders (E.164 format: +1XXXXXXXXXX)
TWILIO_PHONE_NUMBER=

VAULT_ENCRYPTION_KEY=

# PostHog analytics — get your key at https://us.posthog.com/settings/project
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# PostHog source maps — personal API key with write access on error tracking
# Also set these in Vercel → Project Settings → Environment Variables for production builds
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Web Push (VAPID) — generate keys with:
#   node -e "const wp = require('web-push'); const k = wp.generateVAPIDKeys(); console.log(JSON.stringify(k, null, 2));"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose to the browser.
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, and VAPID_SUBJECT must also be set in
# Convex dashboard → Settings → Environment Variables for server-side push delivery.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# The following are server-only — set them in Convex dashboard, not here
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@vadem.app

# Email verification via Resend — set these in Convex dashboard → Settings → Environment Variables
# (NOT in .env.local — Convex actions run outside Next.js and cannot read NEXT_PUBLIC_* vars)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# APP_URL=https://your-domain.com      # Used to build the verification link; use http://localhost:3000 for dev
# EMAIL_FROM=Vadem <noreply@vadem.app> # Optional, defaults to noreply@vadem.app